    "newFormat": "resource:action (e.g., user:read)",
    "essentialRoutes": [
      "Essential routes are accessible to all authenticated users regardless of role/permissions",
      "Essential routes: / (dashboard), /profile",
      "These routes have empty requiredRoles and requiredPermissions arrays"
    ],
    "bulkResourcePermissions": [
      "Bulk resource permissions allow checking all actions on a resource at once:",
      "*:resource - All actions on a resource (read, create, update, delete, manage)",
      "resource:manage - All CRUD actions (read, create, update, delete)",
      "If user has all CRUD permissions for a resource, they effectively have manage permission"
    ]
  },
