{
  "version": "1.0.0",
  "loginRedirects": {
    "SabyUser": "/",
    "SuperUser": "/",
    "Owner": "/",
    "Admin": "/",
    "OrdinaryUser": "/",
    "default": "/"
  },
  "unauthorizedRedirects": {
    "authenticated": "/access-denied",
    "unauthenticated": "/auth/sign-in"
  },
  "logoutRedirect": "/auth/sign-in",
  "sessionExpiredRedirect": "/auth/sign-in?session=expired",
  "channelRestrictions": {
    "web": {
      "allowedRoles": ["SabyUser", "SuperUser", "Owner", "Admin"],
      "deniedRedirect": "/access-denied"
    }
  }
}
